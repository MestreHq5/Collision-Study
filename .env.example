# Copy this file to `.env` (gitignored -- it's per-machine, never commit it)
# and fill in what you need. Any variable left unset here falls back to the
# app's previous hardcoded default, so an empty/missing .env changes nothing.

# Where per-run workspaces (Recording.mp4, disk_tracks.csv, data.xlsx, ...)
# get created, one subfolder per group. Default when unset: ~/Desktop.
# DEM_WORKSPACE_ROOT=C:\Users\you\Desktop\Collision_Study

# ntfy.sh topic for the run-complete push notification (notifier.py).
# Pick something long/hard-to-guess -- ntfy.sh topics are unauthenticated.
# Unset = notifications are a silent no-op.
# NTFY_TOPIC=your-chosen-topic-name
